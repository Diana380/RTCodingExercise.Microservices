@model IEnumerable<Catalog.Domain.Plate>

@{
	ViewData["Title"] = "Home Page";
}

<div class="text-center">
	<h1 class="display-4">Welcome</h1>
</div>
<form asp-action="Index" method="get">
	<div class="form-actions no-color">
		<p>
			<label>Find by letters or numbers: <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]" /></label>
			<input type="submit" value="Search" class="btn btn-default" /> |
			<a asp-action="Index">Back to Full List</a>
		</p>
	</div>
</form>
<table>
	<thead>
		<tr>
			<th>|Registration |</th>
			<th>Purchase price |</th>
			<th><a asp-action="Index" asp-route-sortOrder="@ViewData["PriceSortParam"]">@Html.DisplayNameFor(model => model.SalePrice)</a>|</th>
		</tr>
	</thead>
	<tbody>
	@foreach (var item in Model)
	{
		<tr>
			<td>@item.Registration</td>
			<td>@item.PurchasePrice</td>
			<td>@item.SalePrice</td>
		</tr>
	}
	</tbody>
</table>